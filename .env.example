# Copy to backend/.env to run the API outside Docker (uvicorn app.main:app --reload).
# In production these come from AWS Secrets Manager, never from a file.
ENV=local
DATABASE_URL=postgresql+psycopg://culture:culture@localhost:5432/culture
JWT_SECRET=local-dev-secret-not-for-production
CORS_ORIGINS=http://localhost:4173,http://127.0.0.1:4173
COOKIE_SECURE=false
# COOKIE_DOMAIN=.chiculturecrew.com
